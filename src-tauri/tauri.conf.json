{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoClipper",
  "version": "0.1.1",
  "identifier": "com.autoclipper.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoClipper",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/transcribe.py": "scripts/transcribe.py",
      "../scripts/burn_subtitles.py": "scripts/burn_subtitles.py",
      "../scripts/smart_crop.py": "scripts/smart_crop.py",
      "../scripts/face_censor.py": "scripts/face_censor.py",
      "../scripts/download_whisper_model.py": "scripts/download_whisper_model.py",
      "../scripts/download_llama_server.py": "scripts/download_llama_server.py",
      "vendor/bin/*": "vendor/bin/"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
